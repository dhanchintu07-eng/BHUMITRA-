# GEMINI_API_KEY: Primary engine for BHUMITRA AI calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional secondary AI engine for BHUMITRA AI.
OPENAI_API_KEY=""

# DATA_GOV_IN_API_KEY: Optional Government of India Open Data API key for live AGMARKNET feed.
DATA_GOV_IN_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
